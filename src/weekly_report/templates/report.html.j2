<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<title>Reporte semanal — Semana {{ report.week_number }}</title>
<style>
  body{margin:0;font-family:'Libre Franklin',system-ui,sans-serif;color:#101828;font-size:14.5px;line-height:1.6}
  h1,h2,h3{margin:0}
  p{margin:0 0 10px}
  table{border-collapse:collapse;width:100%}
  .page{max-width:820px;margin:0 auto;padding:0.7in}
  .topbar{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #E4E7EC;padding-bottom:8px;margin-bottom:26px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:#667085}
  .section{font-size:12px;font-family:'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase;color:#7B2233;padding-bottom:6px;border-bottom:2px solid #101828;margin-bottom:12px}
  .cards{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:26px}
  .card{border:1px solid #E4E7EC;padding:12px 14px}
  .card .label{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.09em;text-transform:uppercase;color:#667085;margin-bottom:6px}
  .card .value{font-size:17px;font-weight:600}
  .card .sub{font-size:12.5px;color:#475467;margin-top:4px}
  th{text-align:left;padding:8px 10px;border-bottom:1px solid #D0D5DD;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.08em;text-transform:uppercase;color:#475467;background:#FAF4F5}
  td{padding:9px 10px;border-bottom:1px solid #F0F1F3;vertical-align:top}
  tbody tr:last-child td{border-bottom:none}
  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:6px}
  .status{display:inline-flex;align-items:center;font-weight:600}
  table{margin-bottom:26px;font-size:13px}
  .tag{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.06em;color:#7B2233;background:#FAF4F5;border:1px solid #EBD9DD;padding:1px 5px;margin-right:7px;vertical-align:1px}
  .hint{font-size:12.5px;color:#667085;margin-bottom:12px}
  .item{display:grid;grid-template-columns:22px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid #F0F1F3}
  .item:last-child{border-bottom:none}
  .item .num{font-family:'IBM Plex Mono',monospace;font-size:12px;color:#98A2B3;padding-top:2px}
  .item .result{font-size:13.5px;color:#475467}
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:26px}
  .metric{border:1px solid #E4E7EC;padding:11px 12px}
  .metric .big{font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:600;letter-spacing:-0.02em}
  .metric .name{font-size:11.5px;color:#667085;margin-top:2px}
  .metric .change{font-size:11.5px;font-weight:600}
  .metric .note{font-size:11.5px;color:#98A2B3}
</style>
</head>
<body>
<div class="page">

<div class="topbar">
  <span>Reporte semanal · documento interno</span>
  <span>Preparado por: {{ report.author }}</span>
</div>

<h1 style="font-size:31px;line-height:1.15;font-weight:700;letter-spacing:-0.02em;margin-bottom:6px">Reporte semanal</h1>
<p style="font-size:15px;color:#475467;margin-bottom:22px">{{ report.role }} — <strong style="color:#101828;font-weight:600">Semana {{ report.week_number }} ({{ format_week_range(report.week_start, report.week_end) }})</strong></p>

{% set n_blockers = report.active_blockers | length %}
<div class="cards">
  <div class="card" style="border-top:3px solid #7B2233">
    <div class="label">Estado general</div>
    <div class="value" style="color:{{ status_color(report.overall_status) }}">{{ status_label(report.overall_status) }}</div>
    <div class="sub">{{ report.goals_done }} de {{ report.goals_total }} objetivos de la semana cerrados</div>
  </div>
  <div class="card" style="border-top:3px solid #7B2233">
    <div class="label">Foco de la semana</div>
    <div class="value">{{ report.focus }}</div>
    <div class="sub">{{ report.focus_context }}</div>
  </div>
  <div class="card" style="border-top:3px solid {{ '#B3261E' if n_blockers else '#D0D5DD' }}">
    <div class="label">Atención</div>
    <div class="value" style="color:{{ '#B3261E' if n_blockers else '#667085' }}">{{ n_blockers }} bloqueo{{ 's' if n_blockers != 1 else '' }} activo{{ 's' if n_blockers != 1 else '' }}</div>
    <div class="sub">{{ report.active_blockers[0].title if n_blockers else 'Sin bloqueos' }}</div>
  </div>
</div>

<h2 class="section">01 · Resumen de la semana</h2>
<p style="margin-bottom:26px">{{ report.summary }}</p>

<h2 class="section">02 · Estado por proyecto</h2>
<table>
  <thead>
    <tr>
      <th>Proyecto</th>
      <th style="width:112px">Estado</th>
      <th style="width:62px">Avance</th>
      <th>Hito de esta semana</th>
      <th>Próximo hito</th>
    </tr>
  </thead>
  <tbody>
    {% for p in report.projects %}
    <tr>
      <td style="font-weight:600">{{ p.project }} · {{ p.name }}</td>
      <td><span class="status" style="color:{{ status_color(p.status) }}"><span class="dot" style="background:{{ status_color(p.status) }}"></span>{{ status_label(p.status) }}</span></td>
      <td style="font-family:'IBM Plex Mono',monospace">{{ p.progress }} %</td>
      <td>{{ p.milestone }}</td>
      <td>{{ p.next_milestone or "—" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2 class="section">03 · Logros</h2>
<div style="margin-bottom:26px">
  {% for a in report.achievements %}
  <div class="item">
    <div class="num">{{ "%02d" | format(loop.index) }}</div>
    <div>
      <div style="font-weight:600"><span class="tag">{{ a.project }}</span>{{ a.title }}</div>
      <div class="result">{{ a.result }}</div>
    </div>
  </div>
  {% endfor %}
</div>

<h2 class="section">04 · Obstáculos y bloqueos</h2>
<table>
  <thead>
    <tr>
      <th>Obstáculo</th>
      <th style="width:84px">Impacto</th>
      <th style="width:96px">Responsable</th>
      <th>Qué necesito</th>
    </tr>
  </thead>
  <tbody>
    {% for o in report.obstacles %}
    <tr>
      <td><span class="tag">{{ o.project }}</span>{{ o.title }}</td>
      <td style="color:{{ impact_color(o.impact) }};font-weight:600">{{ impact_label(o.impact) }}</td>
      <td>{{ o.owner }}</td>
      <td>{{ o.need }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2 class="section" style="margin-bottom:6px">05 · Métricas</h2>
<p class="hint">Cambio contra la semana anterior.</p>
<div class="metrics">
  {% for m in report.metrics %}
  <div class="metric">
    <div class="big">{{ metric_value(m) }}</div>
    <div class="name">{{ m.label }}</div>
    {% if m.previous is not none %}
    <div class="change" style="color:{{ change_color(m) }}">{{ change_text(m) }}</div>
    {% endif %}
    {% if m.note %}
    <div class="note">{{ m.note }}</div>
    {% endif %}
  </div>
  {% endfor %}
</div>

</div>
</body>
</html>
